# Database Configuration
DATABASE_URL=postgres://smsadmin:your_secure_password@your-rds-endpoint:5432/smsapp?sslmode=require

# Database Connection Pool Settings (Optional - uses safe defaults if not set)
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=60000
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000

# Authentication (Clerk)
CLERK_PUBLISHABLE_KEY=pk_live_your_production_key_here
CLERK_SECRET_KEY=sk_live_your_production_secret_here
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_production_key_here

# Clerk Routing Configuration
CLERK_SIGN_IN_URL=/login
CLERK_SIGN_UP_URL=/signup

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=sk_live_your_production_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret_here

# SMS Service (Twilio) - Single Centralized Account
# All businesses use this single Twilio account for enhanced security
TWILIO_ACCOUNT_SID=ACyour_production_account_sid_here
TWILIO_AUTH_TOKEN=your_production_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_BUSINESS_PROFILE_SID=BUyour_business_profile_sid_here

# AWS S3 for Image Storage
AWS_ACCESS_KEY_ID=AKIAyour_production_access_key_here
AWS_SECRET_ACCESS_KEY=your_production_secret_access_key_here
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-production-sms-images-bucket
AWS_S3_PUBLIC_URL_BASE=https://your-production-sms-images-bucket.s3.amazonaws.com

# Security
ENCRYPTION_KEY=your_32_character_production_encryption_key_here

# Application Configuration
NODE_ENV=production
PORT=5000
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Feature Flags
# Controls whether failed messages should be retried automatically
# Set to 'true' to enable retries, 'false' to fail immediately (recommended for cost control)
ENABLE_MESSAGE_RETRIES=false

# Optional: External Logging Service
LOG_SERVICE_URL= 